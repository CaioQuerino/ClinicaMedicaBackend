# Configurações do Spring
SPRING_APPLICATION_NAME=ClinicaMedica
SERVER_PORT=8080

# Credenciais do Banco (Para o Docker/Serviço MySQL)
MYSQL_ROOT_PASSWORD=123456
MYSQL_ROOT_USER=root
MYSQL_DATABASE=clinica_db
MYSQL_USER=clinica_user
MYSQL_PASSWORD=clinica123
MYSQL_ROOT_HOST=%

# Conexão que a API usará
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinica_db
DB_USERNAME=root
DB_PASSWORD=123456

# URL de Conexão formatada para o Spring
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&useUnicode=true
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
